/* Configurazione dei test. Non ci sono ancora file .spec.ts: "files": [] evita
   l'errore TS18003 (nessun input trovato) finche' i test non verranno scritti. */
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/spec",
    "types": [
      "jasmine"
    ]
  },
  "files": [],
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
